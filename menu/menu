clear
is_active() { systemctl is-active --quiet "$1" 2>/dev/null; }
status_on_error() { if is_active "$1"; then echo "${green}ON"; else echo "${RED}ERROR"; fi; }
status_any_on_error() {
    for svc in "$@"; do
        if is_active "$svc"; then echo "${green}ON"; return; fi
    done
    echo "${RED}ERROR"
}

