LIGHT='\033[0;37m'
red='\e[1;31m'
green='\e[0;32m'
NC='\e[0m'
red='\e[1;31m'
green='\e[0;32m'
NC='\e[0m'
green() { echo -e "\\033[32;1m${*}\\033[0m"; }
red() { echo -e "\\033[31;1m${*}\\033[0m"; }
clear


NUMBER_OF_CLIENTS=$(grep -c -E "^#! " "/etc/xray/config.json")
	if [[ ${NUMBER_OF_CLIENTS} == '0' ]]; then
		echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "         Hapus Akun Trojan             "
        echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
		echo ""
		echo "Anda Tidak Memiliki Member Trojan"
		echo ""
		echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
		read -n 1 -s -r -p "Press any key to back"
        m-trojan
	fi

	clear
	echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e "          Hapus Akun Trojan            "
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo "  User       Expired  " 
	echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
	grep -E "^#! " "/etc/xray/config.json" | cut -d ' ' -f 2-3 | column -t | sort | uniq
    echo ""
    red "tap enter to go back"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
	source /usr/local/lib/autoscript-vip/selection-compte.sh || exit 1
choisir_compte trojan || exit 0
    if [ -z "$user" ]; then
    m-trojan
    else
    backup_root=$(mktemp -d /root/sauvegarde-suppression-XXXXXX) || exit 1
    chmod 700 "$backup_root"
    cp -p /etc/xray/config.json "$backup_root/config.json" || exit 1
    if [ -f "/etc/trojan/.trojan.db" ]; then cp -p "/etc/trojan/.trojan.db" "$backup_root/compte.db"; fi
    restaurer_compte() {
      cp -p "$backup_root/config.json" /etc/xray/config.json
      if [ -f "$backup_root/compte.db" ]; then cp -p "$backup_root/compte.db" "/etc/trojan/.trojan.db"; fi
    }
    exp=$(grep -wE "^#! $user" "/etc/xray/config.json" | cut -d ' ' -f 3 | sort | uniq)
    sed -i "/^#! $user $exp/,/^},{/d" /etc/xray/config.json
    sed -i "/### $user $exp/,/^},{/d" /etc/trojan/.trojan.db
    if ! /usr/local/bin/xray run -test -config /etc/xray/config.json >/dev/null 2>&1; then
      restaurer_compte
      echo "Configuration Xray invalide : suppression annulée et sauvegarde restaurée."
      exit 1
    fi
    if ! systemctl restart xray || ! systemctl is-active --quiet xray; then
      restaurer_compte
      systemctl restart xray || true
      echo "Xray n'a pas redémarré : configuration restaurée."
      exit 1
    fi
    rm -f -- /etc/trojan/$user
    rm -f -- /etc/kyt/limit/trojan/ip/$user
    rm -f -- /var/www/html/$user.txt
    clear
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo "  Akun Trojan Berhasil Di Hapus         "
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo " Client Name : $user"
    echo " Expired On  : $exp"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo ""
    fi